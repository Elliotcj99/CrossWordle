<?xml version="1.0" encoding="utf-8"?>
<!--
  The IIS site's web.config. The template is deploy/iis/web.config; the headers come from
  deploy/security-headers.json. Edit those, not a rendered copy. scripts/render-headers.mjs
  (format iis) renders it, and `npm run build:iis` runs that.

  Release layout (scripts/deploy-iis.ps1):
    releases\<sha>\site     the site's physical path: apps/web/dist plus this web.config
    releases\<sha>\server   server.mjs, the API with the answers inlined. It sits outside the
                            site, so IIS can never serve it.
-->
<configuration>
  <system.webServer>
    <!-- Never the detailed error pages (they show server paths). IIS sends those to local
         requests, and everything arrives from cloudflared on 127.0.0.1. -->
    <httpErrors errorMode="Custom" />
    <directoryBrowse enabled="false" />
    <security>
      <!-- No Server header. Only the methods the site uses. Bodies capped at the API's own
           16 KB limit, so IIS refuses big uploads itself instead of Node dropping the connection. -->
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false" allowHighBitCharacters="false">
        <requestLimits maxAllowedContentLength="16384" maxUrl="1024" maxQueryString="512" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
        <hiddenSegments>
          <add segment="server" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Folder URLs (/assets/, /puzzles) are 404. Only the site root serves its default
         document. Without this, IIS answers a folder with an empty 200. -->
    <rewrite>
      <rules>
        <rule name="No folder URLs" stopProcessing="true">
          <match url=".+" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Remove first, so these work whether or not the server already maps the extension. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
{{headers}}
      </customHeaders>
    </httpProtocol>
    <!-- HttpPlatformHandler starts Node on demand, restarts it if it dies, and proxies to it.
         The working directory is the site folder (releases\<sha>\site), so these paths are
         relative to it: the server beside the site, and the database folder and settings file in
         the site's root, outside every release. -->
    <httpPlatform processPath="%ProgramFiles%\nodejs\node.exe" arguments="..\server\server.mjs"
                  startupTimeLimit="20" stdoutLogEnabled="false">
      <environmentVariables>
        <environmentVariable name="CROSSWORDLE_DATA" value="..\..\..\data" />
        <environmentVariable name="CROSSWORDLE_CONFIG" value="..\..\..\config.json" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>

  <!-- Only /api goes to Node; everything else is a static file. -->
  <location path="api">
    <system.webServer>
      <handlers>
        <clear />
        <add name="crosswordle-api" path="*" verb="*" modules="httpPlatformHandler"
             resourceType="Unspecified" />
      </handlers>
      <!-- Keep the API's JSON error bodies (404 unknown-puzzle, 409 nothing-to-reveal). -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
{{locations}}
</configuration>
