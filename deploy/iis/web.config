<?xml version="1.0" encoding="utf-8"?>
<!--
  The IIS site's web.config. The template is deploy/iis/web.config; the headers come from
  deploy/security-headers.json. Edit those, not a rendered copy. scripts/render-headers.mjs
  (format iis) renders it, and `npm run build:iis` runs that.

  Release layout (scripts/deploy-iis.ps1):
    releases\<sha>\site     the site's physical path: apps/web/dist plus this web.config
    releases\<sha>\server   server.mjs, the API with the answers inlined. It sits outside the
                            site, so IIS can never serve it.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Remove first, so these work whether or not the server already maps the extension. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
{{headers}}
      </customHeaders>
    </httpProtocol>
    <!-- HttpPlatformHandler starts Node on demand, restarts it if it dies, and proxies to it.
         The working directory is the site folder, so the server path is relative to it. -->
    <httpPlatform processPath="%ProgramFiles%\nodejs\node.exe" arguments="..\server\server.mjs"
                  startupTimeLimit="20" stdoutLogEnabled="false" />
  </system.webServer>

  <!-- Only /api goes to Node; everything else is a static file. -->
  <location path="api">
    <system.webServer>
      <handlers>
        <clear />
        <add name="crosswordle-api" path="*" verb="*" modules="httpPlatformHandler"
             resourceType="Unspecified" />
      </handlers>
      <!-- Keep the API's JSON error bodies (404 unknown-puzzle, 409 nothing-to-reveal). -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
{{locations}}
</configuration>
